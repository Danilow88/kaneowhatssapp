# Copie para ".env" e preencha. Usado pelos serviços kaneo/kaneo-db/bridge-db no docker-compose.yml.

# --- Kaneo ---
KANEO_CLIENT_URL=http://localhost:5173
KANEO_POSTGRES_DB=kaneo
KANEO_POSTGRES_USER=kaneo
KANEO_POSTGRES_PASSWORD=
# Gerar com: openssl rand -hex 32
KANEO_AUTH_SECRET=

# --- Postgres do bridge ---
BRIDGE_POSTGRES_DB=bridge
BRIDGE_POSTGRES_USER=bridge
BRIDGE_POSTGRES_PASSWORD=
# Monte com os 3 valores acima, host bridge-db, porta 5432: <user>:<password>@bridge-db:5432/<db>
BRIDGE_DATABASE_URL=
