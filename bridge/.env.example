PORT=3000

DATABASE_URL=postgresql://bridge:changeme@localhost:5433/bridge

# "meta" é o alvo definitivo. "twilio" é via alternativa temporária (Sandbox)
# pra destravar testes enquanto a verificação de negócio da Meta não sai.
WHATSAPP_PROVIDER=meta

# Meta WhatsApp Cloud API (Meta for Developers > app > WhatsApp > API Setup)
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_ACCESS_TOKEN=
# App Secret do App do Meta (Configurações básicas do app) — usado para validar
# o HMAC do header X-Hub-Signature-256 nos webhooks recebidos.
META_APP_SECRET=
# Token arbitrário escolhido por você, colado também na configuração do
# webhook no painel do Meta (handshake de verificação GET).
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_API_VERSION=v24.0

# Twilio WhatsApp Sandbox (console.twilio.com) — só usado quando
# WHATSAPP_PROVIDER=twilio.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
# URL pública (ngrok em dev) usada para recompor a URL assinada no
# X-Twilio-Signature dos webhooks recebidos.
PUBLIC_WEBHOOK_BASE_URL=

KANEO_API_URL=http://localhost:5173/api
KANEO_API_KEY=
KANEO_PROJECT_ID=
KANEO_FIELD_PHONE_ID=
KANEO_FIELD_CUSTOMER_TYPE_ID=
KANEO_FIELD_NAME_ID=
KANEO_FIELD_EMAIL_ID=
KANEO_WEBHOOK_SECRET=
